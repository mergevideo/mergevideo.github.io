---
import { languages, type SupportedLanguage } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="relative inline-block text-left group" id="language-picker-container">
  <button
    type="button"
    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg text-[#192a3e] bg-white/80 dark:bg-[#131f2d]/80 dark:text-[#F2EFE7] border border-[#C8DFDB] dark:border-[#20364d] hover:bg-[#F2EFE7] dark:hover:bg-[#1c2c3d] transition-all focus:outline-none shadow-sm"
    id="language-picker-button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Select Language"
  >
    <svg class="w-4 h-4 text-[#3368A0] dark:text-[#66A3BF]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span>{languages[currentLang].native}</span>
    <svg class="w-3.5 h-3.5 text-[#66A3BF] dark:text-[#adc5d8] group-hover:text-[#3368A0] transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div
    class="absolute right-0 mt-1.5 w-40 rounded-xl bg-white dark:bg-[#131f2d] border border-[#C8DFDB] dark:border-[#20364d] shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-150 z-50 py-1.5"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="language-picker-button"
  >
    {(Object.keys(languages) as SupportedLanguage[]).map((langKey) => {
      const isCurrent = langKey === currentLang;
      const targetUrl = getLocalizedPath(currentPath, langKey);
      return (
        <a
          href={targetUrl}
          class:list={[
            "flex items-center justify-between px-3.5 py-2 text-xs transition-colors",
            isCurrent
              ? "bg-[#eaf1f7] dark:bg-[#1e344b] text-[#3368A0] dark:text-[#66A3BF] font-semibold"
              : "text-[#192a3e] dark:text-[#F2EFE7] hover:bg-[#F2EFE7] dark:hover:bg-[#1a293a]"
          ]}
          role="menuitem"
          hreflang={langKey}
        >
          <span>{languages[langKey].native}</span>
          <span class="text-[10px] text-[#66A3BF] dark:text-[#adc5d8] uppercase tracking-wider">{langKey}</span>
        </a>
      );
    })}
  </div>
</div>
