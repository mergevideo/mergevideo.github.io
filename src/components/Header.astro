---
import { defaultLang, type SupportedLanguage } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.jsx';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = getLocalizedPath('/', lang);
---

<header class="sticky top-0 z-40 w-full border-b border-[#C8DFDB]/80 dark:border-[#1e344b]/80 bg-[#F2EFE7]/90 dark:bg-[#0c1520]/90 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-2 group flex-shrink-0">
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#3368A0] flex items-center justify-center text-white shadow-md shadow-[#3368A0]/30 group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-black text-[#192a3e] dark:text-[#F2EFE7] tracking-tight text-sm sm:text-lg leading-tight flex items-center gap-1">
          MergeVideo<span class="text-[#3368A0] dark:text-[#66A3BF]">.io</span>
        </span>
        <span class="text-[9px] sm:text-[10px] text-[#66A3BF] dark:text-[#adc5d8] font-medium leading-none hidden md:inline">
          100% Client-Side
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6 text-xs sm:text-sm font-medium text-[#4a5d72] dark:text-[#adc5d8]">
      <a href="#features" class="hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
        {t('nav.features')}
      </a>
      <a href="#how-it-works" class="hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
        {t('nav.howItWorks')}
      </a>
      <a href="#faq" class="hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
        {t('nav.faq')}
      </a>
    </nav>

    <!-- Controls: Language, Theme & BuyMeACoffee -->
    <div class="flex items-center gap-1.5 sm:gap-2.5">
      <LanguagePicker currentLang={lang} />
      <ThemeToggle client:load label={t('nav.theme')} />

      <!-- Support the Developer (Desktop: Icon + Text | Mobile: Icon Only) -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 p-2 sm:px-3 sm:py-1.5 text-xs font-semibold rounded-lg text-[#92400e] dark:text-[#fef3c7] bg-[#fef3c7] dark:bg-[#78350f]/50 border border-[#fde68a] dark:border-[#92400e]/80 hover:bg-[#fde68a] dark:hover:bg-[#78350f]/80 transition-all shadow-sm group"
        aria-label="Support the Developer"
        title="Support the Developer"
      >
        <svg class="w-4 h-4 text-[#d97706] dark:text-[#fbbf24] flex-shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.054-.305-.289-.538-.612-.538-.379 0-.758 0-1.137 0-3.322 0-6.643 0-9.965 0-.585 0-1.066.393-1.183.966-.356 1.748-.707 3.498-1.058 5.248-.052.257-.024.463.158.672.296.341.696.536 1.132.612.441.077.89.043 1.332.062.06.003.122.019.18.038.006.126.012.252.019.378.093 1.714.186 3.428.28 5.142.065 1.183.568 2.164 1.542 2.802.932.611 2 .848 3.107.87 1.385.027 2.76.01 4.14-.047 1.258-.052 2.378-.458 3.27-1.379.799-.824 1.205-1.848 1.295-2.98.118-1.488.232-2.977.348-4.466.029-.37.058-.74.086-1.111 1.218-.088 2.228-.68 2.659-1.854.12-.328.188-.679.227-1.031.025-.224-.038-.383-.177-.525zm-3.045 2.179c-.06.776-.566 1.372-1.317 1.528-.109.023-.223.033-.334.037-.087.003-.174-.016-.261-.025-.018-.288-.035-.576-.054-.864-.092-1.428-.184-2.855-.276-4.283-.008-.124.034-.182.155-.181.567.004 1.134.004 1.701.006.273.001.442.148.497.414.05.244.095.49.141.736.082.428.163.856.244 1.284.05.267.014.512-.136.74-.098.148-.225.268-.36.608z"/>
        </svg>
        <span class="hidden sm:inline font-medium">{t('nav.support')}</span>
      </a>
    </div>
  </div>
</header>
